@page
@model HomecrestWeatherAlert.Pages.Employees.CreateModel
@{
    ViewData["Title"] = "Add employee";
}

<h1 class="h3 mb-3">Add employee</h1>

<form method="post" class="col-md-6">
    <div asp-validation-summary="ModelOnly" class="text-danger"></div>

    <div class="mb-3">
        <label asp-for="Input.Name" class="form-label"></label>
        <input asp-for="Input.Name" class="form-control" />
        <span asp-validation-for="Input.Name" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="Input.Phone" class="form-label"></label>
        <input asp-for="Input.Phone" class="form-control" placeholder="555-123-4567 or +15551234567" />
        <span asp-validation-for="Input.Phone" class="text-danger"></span>
        <div class="form-text">Stored as entered; normalized to E.164 for Twilio.</div>
    </div>

    <div class="mb-3">
        <label asp-for="Input.IsActive" class="form-label"></label>
        @* Use a single-value select — checkbox+hidden posts two values and FirstValue binding is fragile. *@
        <select asp-for="Input.IsActive" class="form-select" asp-items="Model.ActiveOptions"></select>
        <div class="form-text">Set Inactive only for leavers / HR removal. Login and app startup never change this.</div>
        <span asp-validation-for="Input.IsActive" class="text-danger"></span>
    </div>

    <button type="submit" class="btn btn-primary">Save</button>
    <a asp-page="./Index" class="btn btn-link">Cancel</a>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
