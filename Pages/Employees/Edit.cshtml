@page "{id:int}"
@model HomecrestWeatherAlert.Pages.Employees.EditModel
@{
    ViewData["Title"] = "Edit employee";
}

<h1 class="h3 mb-3">Edit employee</h1>

<form method="post" class="col-md-6">
    <div asp-validation-summary="ModelOnly" class="text-danger"></div>
    <input type="hidden" asp-for="Input.Id" />

    <div class="mb-3">
        <label asp-for="Input.Name" class="form-label"></label>
        <input asp-for="Input.Name" class="form-control" />
        <span asp-validation-for="Input.Name" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="Input.Phone" class="form-label"></label>
        <input asp-for="Input.Phone" class="form-control" />
        <span asp-validation-for="Input.Phone" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="Input.IsActive" class="form-label"></label>
        <select asp-for="Input.IsActive" class="form-select" asp-items="Model.ActiveOptions"></select>
        <div class="form-text">Set Inactive for leavers / HR removal, or after an SMS STOP opt-out. Setting Active clears the opt-out timestamp.</div>
        <span asp-validation-for="Input.IsActive" class="text-danger"></span>
    </div>

    @if (Model.OptedOutAt.HasValue)
    {
        <div class="alert alert-warning py-2">
            Opted out via SMS at <strong>@Model.OptedOutAt.Value.UtcDateTime.ToString("yyyy-MM-dd HH:mm:ss") UTC</strong>.
        </div>
    }

    <button type="submit" class="btn btn-primary">Save</button>
    <a asp-page="./Index" class="btn btn-link">Cancel</a>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
