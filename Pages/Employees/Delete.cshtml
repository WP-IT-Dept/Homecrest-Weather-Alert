@page "{id:int}"
@model HomecrestWeatherAlert.Pages.Employees.DeleteModel
@{
    ViewData["Title"] = "Delete employee";
}

<h1 class="h3 mb-3">Delete employee</h1>

@if (Model.Employee is not null)
{
    <p>Remove <strong>@Model.Employee.Name</strong> (@Model.Employee.Phone) from the list?</p>
    <form method="post">
        <button type="submit" class="btn btn-danger">Delete</button>
        <a asp-page="./Index" class="btn btn-link">Cancel</a>
    </form>
}
