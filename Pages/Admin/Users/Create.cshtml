@page
@model HomecrestWeatherAlert.Pages.Admin.Users.CreateModel
@{
    ViewData["Title"] = "Create user";
}

<h1 class="h3 mb-3">Create user login</h1>

<form method="post" class="col-md-6">
    <div asp-validation-summary="ModelOnly" class="text-danger"></div>

    <div class="mb-3">
        <label asp-for="Input.Email" class="form-label"></label>
        <input asp-for="Input.Email" class="form-control" />
        <span asp-validation-for="Input.Email" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="Input.Password" class="form-label"></label>
        <input asp-for="Input.Password" class="form-control" />
        <span asp-validation-for="Input.Password" class="text-danger"></span>
        <div class="form-text">Share this temporary password securely; the user can change it after login.</div>
    </div>

    <div class="form-check mb-3">
        <input type="hidden" name="Input.IsAdmin" value="false" />
        <input asp-for="Input.IsAdmin" class="form-check-input" />
        <label asp-for="Input.IsAdmin" class="form-check-label"></label>
    </div>

    <button type="submit" class="btn btn-primary">Create</button>
    <a asp-page="./Index" class="btn btn-link">Cancel</a>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
