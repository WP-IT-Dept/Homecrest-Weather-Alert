@page "{id}"
@model HomecrestWeatherAlert.Pages.Admin.Users.ResetPasswordModel
@{
    ViewData["Title"] = "Reset password";
}

<h1 class="h3 mb-3">Reset password</h1>
<p>Set a new password for <strong>@Model.Email</strong>.</p>

<form method="post" class="col-md-6">
    <div asp-validation-summary="ModelOnly" class="text-danger"></div>
    <input type="hidden" asp-for="Input.Id" />

    <div class="mb-3">
        <label asp-for="Input.NewPassword" class="form-label"></label>
        <input asp-for="Input.NewPassword" class="form-control" />
        <span asp-validation-for="Input.NewPassword" class="text-danger"></span>
    </div>

    <button type="submit" class="btn btn-primary">Reset password</button>
    <a asp-page="./Index" class="btn btn-link">Cancel</a>
</form>

<form method="post" asp-page-handler="EmailResetLink" class="col-md-6 mt-4 pt-3 border-top">
    <input type="hidden" name="id" value="@Model.Input.Id" />
    <p class="text-muted small">Or email a self-serve reset link (Microsoft Graph / Exchange Online).</p>
    @if (Model.EmailConfigured)
    {
        <button type="submit" class="btn btn-outline-secondary">Email password reset link</button>
    }
    else
    {
        <button type="submit" class="btn btn-outline-secondary" disabled>Email password reset link</button>
    }
    @if (!Model.EmailConfigured)
    {
        <div class="form-text">Configure Exchange Online under <a asp-page="/Admin/Config/Index">Integrations</a>.</div>
    }
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
